{
  "description": "Keep the triad planner and reviewer read-only, and keep the reviewer out of the implementer's notes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
